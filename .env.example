# Contact form. Leave either blank and the form is hidden (the mailto link remains).
# Formspree form ID: the part after /f/ in your form endpoint.
REACT_APP_FORMSPREE_FORM_ID=
# Google reCAPTCHA v2 ("I'm not a robot" checkbox) SITE key. Public by design.
# The matching SECRET key goes in the Formspree dashboard, never in this repo.
REACT_APP_RECAPTCHA_SITE_KEY=
